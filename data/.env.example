# =============================================================================
# CareerPilot — environment / secrets template
# =============================================================================
# HOW TO USE
#   1. Copy this file to:  .env   (same folder: data/.env)
#   2. Replace every dummy value with YOUR secrets
#   3. NEVER commit the real .env file
#
# This file is safe to commit (fake values only).
# Paths below assume the recommended Windows layout:
#   C:\CareerPilot\app   = Git repository
#   C:\CareerPilot\data  = this data root
# =============================================================================

# ---- Install layout (optional; Task Scheduler / setup usually set these) ----
# Prefer User environment variables on Windows; values here also work if you
# load this .env before starting CareerPilot.
CAREERPILOT_HOME=C:\CareerPilot
CAREERPILOT_DATA_ROOT=C:\CareerPilot\data
# CAREERPILOT_BACKUPS_ROOT=C:\CareerPilot\backups

# ---- Gemini (primary AI provider in config.example.yaml) --------------------
# At least ONE AI provider key is required for scoring / cover letters.
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
# Alias some docs use — map it in config via ai.providers.gemini.api_key_envs
# if you prefer a single name:
# GEMINI_API_KEY=your-gemini-api-key

# ---- Other AI providers (enable the matching block in config.yaml) ----------
DEEPSEEK_API_KEY=your-deepseek-api-key
GLM_API_KEY=your-glm-api-key
KIMI_API_KEY=your-kimi-api-key
MINIMAX_API_KEY=your-minimax-api-key
# OpenAI / OpenRouter / Together / etc. — only if you add a provider with
# api_key_env: OPENAI_API_KEY (or OPENROUTER_API_KEY) in config.yaml
OPENAI_API_KEY=sk-your-openai-api-key
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ---- Telegram notifications (optional but recommended) ----------------------
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken_ReplaceMe
TELEGRAM_CHAT_ID=123456789

# ---- Ops Mission Control dashboard (required when host is not loopback) -----
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
# Optional stable session signing key (randomised each process start if unset)
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-hex-string
# Alias accepted by the dashboard auth layer:
# CAREERPILOT_DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# ---- Email (RESERVED — Email Manager not implemented yet) -------------------
EMAIL_PASSWORD=your-email-app-password

# ---- Portal logins — NOT used by CareerPilot today --------------------------
# CareerPilot does NOT read LinkedIn/Naukri username/password from .env.
# Log in once in a headed browser; sessions live under data/browser/{linkedin,naukri}/.
# Kept here only so operators do not invent a second secret store:
# LINKEDIN_USERNAME=example@email.com
# LINKEDIN_PASSWORD=your-password
# NAUKRI_USERNAME=example@email.com
# NAUKRI_PASSWORD=your-password

# ---- Logging ----------------------------------------------------------------
# CareerPilot reads logging.level from config/config.yaml (not this variable).
# Included so deploy scripts can document intent; set level in YAML for effect:
LOG_LEVEL=INFO
