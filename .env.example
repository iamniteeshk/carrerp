# CareerPilot secrets. Copy to .env and fill in. NEVER commit .env.
#
# You must fill these yourself. Setup cannot invent them.
#   TELEGRAM_BOT_TOKEN     Telegram bot from @BotFather (approval + notices)
#   TELEGRAM_CHAT_ID       the chat that should receive those messages
#   DASHBOARD_USER         login for the dashboard on this PC and the home LAN
#   DASHBOARD_PASSWORD     change this. The example below is UNSAFE.
#
# Cloud AI keys are optional when config uses local Ollama.

# Gemini API keys (optional when ai.active_provider is ollama).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# DeepSeek fallback (optional).
DEEPSEEK_API_KEY=

# Telegram — required for Approval mode and for notifications.
# Create a bot with @BotFather, then put the token and your chat id here.
# CareerPilot reads these names exactly. Do not put them in config.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (reserved; only if you enable the future Email Manager).
EMAIL_PASSWORD=

# Dashboard login. The dashboard listens on the home network (0.0.0.0:5000).
# EVERY page asks for this login, including status and Start/Pause/Stop.
# UNSAFE DEFAULTS — change both before you open the dashboard from another device.
# Do not forward port 5000 to the public internet.
DASHBOARD_USER=Admin
DASHBOARD_PASSWORD=Adming
# Optional fixed session secret (otherwise a random key is used each process).
# FLASK_SECRET_KEY=
