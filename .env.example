# CareerPilot secrets. Copy to .env and fill in. NEVER commit .env.

# Gemini API keys (1-3). At least one AI provider key is required.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# DeepSeek fallback (optional; China-based provider).
DEEPSEEK_API_KEY=

# Telegram bot (optional but recommended for notifications).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ops dashboard (required when dashboard.host is not loopback).
DASHBOARD_PASSWORD=
# Optional: override session signing key (randomised each start if unset).
# DASHBOARD_SESSION_SECRET=

# Email (reserved; only if you enable the future Email Manager).
EMAIL_PASSWORD=
