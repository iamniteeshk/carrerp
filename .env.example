# CareerPilot secrets. Copy to .env and fill in. NEVER commit .env.
#
# Preferred detailed template (same content, richer comments):
#   data/.env.example
#
# Copy to the live data root:
#   C:\CareerPilot\data\.env

# ---- Install layout (optional) ----
CAREERPILOT_HOME=C:\CareerPilot
CAREERPILOT_DATA_ROOT=C:\CareerPilot\data
# CAREERPILOT_BACKUPS_ROOT=C:\CareerPilot\backups

# ---- Gemini (at least one AI provider key required) ----
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3

# ---- Other AI providers (enable matching block in config.yaml) ----
DEEPSEEK_API_KEY=your-deepseek-api-key
GLM_API_KEY=your-glm-api-key
KIMI_API_KEY=your-kimi-api-key
MINIMAX_API_KEY=your-minimax-api-key
OPENAI_API_KEY=sk-your-openai-api-key

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken_ReplaceMe
TELEGRAM_CHAT_ID=123456789

# ---- Ops dashboard (required when host is not loopback) ----
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
# DASHBOARD_SESSION_SECRET=replace-with-a-long-random-hex-string
# CAREERPILOT_DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# ---- Email (reserved; Email Manager not implemented yet) ----
EMAIL_PASSWORD=your-email-app-password

# Portal passwords are NOT read from .env — log in via headed browser once.
# LINKEDIN_USERNAME=example@email.com
# LINKEDIN_PASSWORD=your-password

# Logging level is set in config.yaml → logging.level (not this variable).
LOG_LEVEL=INFO
