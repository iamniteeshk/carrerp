# CareerPilot secrets. Copy to .env and fill in. NEVER commit .env.
#
# Setup copies this file to .env when .env is missing. It does not invent
# real secrets. Replace every value marked MUST REPLACE before Doctor can pass.
#
# MUST REPLACE:
#   TELEGRAM_BOT_TOKEN     Telegram bot token from @BotFather
#   TELEGRAM_CHAT_ID       numeric chat id that receives approval messages
#   DASHBOARD_USER         dashboard login (do not leave Admin)
#   DASHBOARD_PASSWORD     dashboard password (do not leave Adming)
#
# Optional. Leave blank when ai.active_provider is ollama (this deployment).
#   GEMINI_API_KEY_1
#   GEMINI_API_KEY_2
#   GEMINI_API_KEY_3
#   DEEPSEEK_API_KEY
#   EMAIL_PASSWORD         reserved; unused unless the email manager is enabled
#   FLASK_SECRET_KEY       optional fixed dashboard session key
#   DASHBOARD_SECRET_KEY   same purpose; used only if FLASK_SECRET_KEY is empty

# Optional cloud keys. Not required for local Ollama.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
DEEPSEEK_API_KEY=

# MUST REPLACE. Telegram — required for Approval mode and for notifications.
# Create a bot with @BotFather. CareerPilot reads these names exactly.
# Do not put the token or chat id in config.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reserved. Leave empty.
EMAIL_PASSWORD=

# MUST REPLACE. Dashboard login.
# The dashboard listens on the home network (0.0.0.0:5000).
# Every page asks for this login, including status and Start/Pause/Stop.
# The values below are the unsafe examples Doctor rejects.
# Do not forward port 5000 to the public internet.
DASHBOARD_USER=Admin
DASHBOARD_PASSWORD=Adming

# Optional. Uncomment and set one long random string if you want the
# dashboard login session to survive a restart. Otherwise each process
# uses a new random key and you sign in again after a restart.
# FLASK_SECRET_KEY=
# DASHBOARD_SECRET_KEY=
