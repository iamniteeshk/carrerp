# CareerPilot secrets. Copy to .env and fill in. NEVER commit .env.

# Gemini API keys (1-3). At least one AI provider key is required for cloud AI.
# Optional when using local Ollama (see config ai.providers.ollama).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# DeepSeek fallback (optional; China-based provider).
DEEPSEEK_API_KEY=

# Telegram bot (optional but recommended for notifications).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (reserved; only if you enable the future Email Manager).
EMAIL_PASSWORD=

# Flask dashboard: anyone can view stats; only Admin can approve / edit.
# Change these before exposing the dashboard on your LAN.
DASHBOARD_USER=Admin
DASHBOARD_PASSWORD=Adming
# Optional fixed session secret (otherwise a random key is used each process).
# FLASK_SECRET_KEY=
