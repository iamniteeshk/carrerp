# Secrets and personal data -- NEVER commit these.
# Root .env is tracked on purpose while every value is blank. Install and
# setup mark it skip-worktree and register a clean filter that drops values
# if it is staged. Do not put real secrets in any other file.
# Anchored to the repo root so deployment_input/ stays trackable.
/candidate.yaml
/config/config.yaml
/config.yaml

# Installed career profiles (real resumes). The source copies live in
# deployment_input/profiles/ and are committed on purpose.
/profiles/
/documents/
/resumes/

# Runtime artifacts.
careerpilot.pid
/database/
/logs/
/screenshots/
# Runtime artifacts (root-level only -- not careerpilot/reports Python package).
/reports/
/profiles_browser/
/cache/
/debug/

# Python.
__pycache__/
*.pyc
.venv/
.venv
