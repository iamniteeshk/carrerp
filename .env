# Fill these after clone. Leave a line blank until you have the real value.
# Do not commit filled values. Git is set up to keep secrets out of commits
# after Install_CareerPilot.bat (or python -m careerpilot.main setup).

# MUST FILL for Telegram approval and notices.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MUST FILL. Dashboard login on this PC and the home LAN.
# Do not forward port 5000 to the public internet.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional. Leave blank when ai.active_provider is ollama.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
DEEPSEEK_API_KEY=
EMAIL_PASSWORD=

# Optional. Leave blank to use a new session key each time CareerPilot starts.
FLASK_SECRET_KEY=
DASHBOARD_SECRET_KEY=
